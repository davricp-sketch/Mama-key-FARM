----------------------------------------------------------------------
-- LÓGICA DE LA KEY
----------------------------------------------------------------------
local validating = false
local lastTry = 0
local finished = false

local function Validate(rawKey)
    if validating or finished then return end
    local key = (tostring(rawKey or ""):gsub("%s+", ""))
    if key == "" then
        setStatus("KEY  •  ESCRIBE TU KEY", C.bad)
        toast("Falta la key", C.bad)
        return
    end
    if os.clock() - lastTry < 1.5 then return end -- evita spam de clics
    lastTry = os.clock()

    validating = true
    verifyBtn.Text = "..."
    setStatus("VERIFICANDO...", C.amber)

    local callOk, ok, state, message = pcall(VerifyKey, key)
    if not callOk then
        ok, state, message = false, "error", "Ocurrió un error al validar la key."
    end

    verifyBtn.Text = "VERIFICAR"
    validating = false

    if ok then
        finished = true
        SaveKey(key)
        setStatus("Key verificada  •  pidiendo acceso...", C.amber)
        tween(openStroke, TI(0.3), { Color = C.green })
        tween(openArrow, TI(0.3), { TextColor3 = C.green })

        local hwid = GetHWID() or ""
        local passed, source, piece = RequestHub(key, hwid)
        if not passed then
            -- el guardia no dejó pasar: no se entrega nada
            finished = false
            tween(openStroke, TI(0.3), { Color = C.red })
            tween(openArrow, TI(0.3), { TextColor3 = C.red })
            setStatus(tostring(source), C.bad)
            toast("Acceso denegado", C.bad)
            return
        end

        setStatus(message, C.green)
        toast("Acceso concedido", C.green)
        task.wait(1.2)
        closeMenu()
        task.wait(0.5)
        tween(openBtn, TI(0.4, BACK, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -70) })
        task.wait(0.5)
        screen:Destroy()
        RunHub(source, piece)
    elseif state == "revoked" then
        DeleteSavedKey() -- la key guardada ya no sirve
        setStatus(message, C.bad)
        toast("Key rechazada", C.bad)
    else
        setStatus(message, C.amber) -- error de conexión: la key guardada se conserva
        toast("Sin verificar", C.amber)
    end
end


local function GetHWID()
    if type(gethwid) == "function" then
        local ok, value = pcall(gethwid)
        if ok and value and tostring(value) ~= "" then return tostring(value) end
    end
    local ok, value = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if ok and value and tostring(value) ~= "" then return tostring(value) end
    return nil
end

local function LoadSavedKey()
    if readfile and isfile then
        local ok, exists = pcall(function() return isfile(KEY_FILE) end)
        if ok and exists then
            local readOk, content = pcall(function() return readfile(KEY_FILE) end)
            if readOk and type(content) == "string" then
                return (content:gsub("%s+", ""))
            end
        end
    end
    return ""
end

local function SaveKey(key)
    if writefile then pcall(function() writefile(KEY_FILE, key) end) end
end

local function DeleteSavedKey()
    if delfile and isfile then
        pcall(function()
            if isfile(KEY_FILE) then delfile(KEY_FILE) end
        end)
    end
end

----------------------------------------------------------------------
-- CONEXIÓN CON EL WORKER. Devuelve: ok, state, message
--   state: "valid" | "revoked" | "error"
----------------------------------------------------------------------
local function VerifyKey(key)
    if not httpRequest then
        return false, "error", "Tu ejecutor no permite solicitudes HTTP."
    end
    local hwid = GetHWID()
    if not hwid then
        return false, "error", "No se pudo obtener el identificador del dispositivo."
    end

    local ok, response = pcall(function()
        return httpRequest({
            Url = WORKER_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["X-DVDR-Auth"] = AUTH_TOKEN
            },
            Body = HttpService:JSONEncode({ key = key, hwid = hwid })
        })
    end)
    if not ok or type(response) ~= "table" or type(response.Body) ~= "string" then
        return false, "error", "No se pudo conectar con el servidor de keys."
    end

    local decodeOk, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
    if not decodeOk or type(data) ~= "table" then
        return false, "error", "El servidor devolvió una respuesta inválida."
    end

    if data.success == true then
        return true, "valid", data.message or "Key verificada correctamente."
    end
    return false, (data.state == "revoked") and "revoked" or "error", data.message or "Key inválida."
end

local function Hash(s)
    local function fnv(str, seed)
        local h = seed
        for i = 1, #str do
            h = bit32.bxor(h, string.byte(str, i))
            h = (h + bit32.lshift(h, 1) + bit32.lshift(h, 4) + bit32.lshift(h, 7)
                + bit32.lshift(h, 8) + bit32.lshift(h, 24)) % 4294967296
        end
        return h
    end
    return string.format("%08x%08x", fnv(s, 0x811C9DC5), fnv(s .. "#", 0x9E3779B9))
end

-- Cuando la key es válida: firma la pieza con la clave A y pide el hub al Worker (GET).
-- El Worker responde el código Lua del hub directamente. Cualquier fallo = no se entrega nada.
-- Devuelve: true, source, piece   |   false, mensaje
local function RequestHub(key, hwid)
    if not httpRequest then return false, "Tu ejecutor no permite solicitudes HTTP." end

    local ts = os.time()
    local sig = Hash(SECRET_A .. "|" .. key .. "|" .. hwid .. "|" .. tostring(ts))

    local ok, response = pcall(function()
        return httpRequest({
            Url = GUARD_URL,
            Method = "GET",
            Headers = {
                ["X-DVDR-Auth"] = AUTH_TOKEN,
                ["User-Agent"] = "DVDR-Loader/1.0",
                ["Accept"] = "text/plain",
            },
        })
    end)
    if not ok or type(response) ~= "table" or type(response.Body) ~= "string" then
        return false, "No se pudo conectar con el servidor."
    end
    if response.StatusCode ~= 200 then
        local msg = "Acceso denegado (" .. tostring(response.StatusCode) .. ")"
        local detail = response.Body:sub(1, 60)
        if #detail > 0 and not detail:find("[\r\n<{]") then msg = msg .. " " .. detail end
        return false, msg
    end

    local source = response.Body
    if #source == 0 or not loadstring(source) then
        return false, "Respuesta inválida del servidor."
    end

    return true, source, { key = key, hwid = hwid, ts = ts, sig = sig }
end

-- Deja la pieza donde el hub la lee y ejecuta el hub.
local function RunHub(source, piece)
    local env = (getgenv and getgenv()) or _G
    env[PIECE_NAME] = piece
    local fn, err = loadstring(source)
    if not fn then
        env[PIECE_NAME] = nil
        warn("DVDR FARM: no se pudo preparar el hub: " .. tostring(err))
        return
    end
    task.spawn(function()
        local runOk, runErr = pcall(fn)
        if not runOk then warn("DVDR FARM: " .. tostring(runErr)) end
    end)
end


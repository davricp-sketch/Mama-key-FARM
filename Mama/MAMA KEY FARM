    if validating or finished then return end
    input.Text = ""
    DeleteSavedKey()
    setStatus("KEY  •  SIN VERIFICAR", C.muted)
    toast("Key borrada", C.muted)
end)

-- animación de entrada: baja el botón superior y se abre la ventana
task.spawn(function()
    task.wait(0.25)
    tween(openBtn, TI(0.7, BACK), { Position = UDim2.new(0.5, 0, 0, 12) })
    task.wait(0.5)
    openMenu()
    -- si hay una key guardada, se valida sola
    if input.Text ~= "" then
        task.wait(0.8)
        Validate(input.Text)
    end
end)
